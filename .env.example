# ==============================================================================
# VASTU VIHAR NEPAL - ENVIRONMENT CONFIGURATION
# ==============================================================================

# --- Database Configuration ---
# Local SQLite database path (used by Prisma CLI and Node.js dev server fallback)
DATABASE_URL="file:./dev.db"

# --- Security & Authentication ---
# Secret key used for signing and verifying administrative session JWT tokens
# Generate a strong 32+ character random secret in production
JWT_SECRET="vastu-vihar-nepal-super-secret-jwt-key-2026-auth"

# --- Public Site Configuration ---
# Base URL for public site links and preview redirects
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Cloudflare D1 Deployment Settings (For reference when deploying) ---
# Cloudflare Worker Name: vastuviharnepal
# Cloudflare D1 Database Binding: DB
# Cloudflare D1 Database Name: vastu-vihar-db
# Set JWT_SECRET in Cloudflare Dashboard: Settings -> Variables and Secrets
