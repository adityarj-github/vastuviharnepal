{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "vastu-vihar-nepal",
	"compatibility_date": "2024-12-30",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "vastu-vihar-nepal"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "vastu-vihar-db",
			"database_id": "vastu-vihar-db-id",
			"migrations_dir": "migrations"
		}
	],
	"vars": {
		"JWT_SECRET": "vastu-vihar-nepal-super-secret-jwt-key-2026-auth"
	}
}
