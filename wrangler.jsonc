{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "vastu-vihar-nepal",
	"account_id": "7c744d89a9c22ae3cdd2ae56f60024f4",
	"compatibility_date": "2024-12-30",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "vastu-vihar-nepal"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "vastu-vihar-db",
			"database_id": "e352fcd6-2327-4eea-bfbb-298f3c176be4",
			"migrations_dir": "migrations"
		}
	]
	// JWT_SECRET is stored as an encrypted Worker secret, not here:
	//   npx wrangler secret put JWT_SECRET
}
